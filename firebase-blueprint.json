  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public campus seller and student profiles without PII."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private student PII isolated from public reads."
    },
    "/users/{userId}/favorites/{listingId}": {
      "schema": { "$ref": "#/entities/FavoriteItem" },
      "description": "Saved wishlist/favorite listings for a student account."
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Goods and services offered across UCC campus halls and markets."
    },
    "/listings/{listingId}/photos/{photoId}": {
      "schema": { "$ref": "#/entities/ListingPhoto" },
      "description": "Gallery photos uploaded by sellers for each listing."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "1-on-1 buyer-seller conversation threads anchored to a listing."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Real-time immutable messages inside a conversation thread."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Student ratings and reviews anchored to marketplace listings."
    },
    "/referralCodes/{code}": {
      "schema": { "$ref": "#/entities/ReferralCode" },
      "description": "Exact-match lookup table for referral invite codes."
    },
    "/referrals/{referralId}": {
      "schema": { "$ref": "#/entities/Referral" },
      "description": "Student referral tracking and admin-approved campus credit rewards."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Completed campus order receipts preserved in buyer and seller order history."
    }
  }
}
