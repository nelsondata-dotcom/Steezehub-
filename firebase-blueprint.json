        "proposedPaymentMethod": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "conversationId",
        "senderId",
        "senderName",
        "participantIds",
        "text",
        "kind",
        "createdAt"
      ]
    },
