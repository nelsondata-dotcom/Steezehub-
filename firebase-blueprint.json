          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "paymentMethod": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "buyerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
