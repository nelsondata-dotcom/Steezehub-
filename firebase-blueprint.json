{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public UCC campus student/seller profile without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "hall": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "program": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80
        },
        "bio": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "photoURL": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "referralCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "acceptedPaymentMethods": {
          "type": "array"
        },
        "sellerTier": {
          "type": "string",
          "enum": ["micro", "standard", "premium"]
        },
        "requestedSellerTier": {
          "type": "string",
          "enum": ["micro", "standard", "premium"]
        },
        "sellerTierStatus": {
          "type": "string",
          "enum": ["pending", "approved"]
        },
        "verifiedCampus": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "hall",
        "verifiedCampus",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated private student PII (email, phone, and preferred payout number).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "preferredPaymentMethod": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "updatedAt"
      ]
    },
    "FavoriteItem": {
      "title": "FavoriteItem",
      "description": "Saved wishlist/favorite listing belonging to a specific student.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "listingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "listingTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "listingPriceGhs": {
          "type": "number"
        },
        "listingImageUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150000
        },
        "sellerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sellerHall": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "meetupZone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "grouping": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "listingId",
        "listingTitle",
        "listingPriceGhs",
        "sellerName",
        "sellerHall",
        "meetupZone",
        "createdAt"
      ]
    },
    "Listing": {
      "title": "Listing",
      "description": "Campus good or service published by a UCC seller with grouping, brand, and payment methods.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sellerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sellerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "sellerHall": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1200
        },
        "type": {
          "type": "string",
          "enum": ["good", "service"]
        },
        "grouping": {
          "type": "string",
          "enum": [
            "Campus Essentials",
            "Hall Life & Dorm",
            "Academic & Tech",
            "Fashion & Beauty",
            "Food & Errands",
            "Events & Tickets"
          ]
        },
        "brand": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "category": {
          "type": "string",
          "enum": [
            "Apparel & Thrift",
            "Tech & Accessories",
            "Textbooks & Study",
            "Food & Drinks",
            "Grooming & Beauty",
            "Design & Repairs",
            "Laundry & Errands"
          ]
        },
        "priceGhs": {
          "type": "number"
        },
        "priceUnit": {
          "type": "string",
          "minLength": 2,
          "maxLength": 30
        },
        "acceptedPaymentMethods": {
          "type": "array"
        },
        "meetupZone": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "conditionOrTurnaround": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "imageUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150000
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "sold"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "sellerId",
        "sellerName",
        "sellerHall",
        "title",
        "description",
        "type",
        "grouping",
        "brand",
        "category",
        "priceGhs",
        "priceUnit",
        "acceptedPaymentMethods",
        "meetupZone",
        "conditionOrTurnaround",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
